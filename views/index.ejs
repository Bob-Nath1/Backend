<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <nav>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/create">Create Post</a></li>
        </ul>
    </nav>
    <div class="container">


   <h1>Blog Posts</h1> 
   <ul>
    <% blogPosts.forEach((post, index) => {%>
        <li>
            <h2><%=  post.title  %></h2>
            <p><%=post.content%></p>
            <button class="edit-button"><a href="/edit/<%= index %>">Edit</a></button>
            <button class="delete-button" onclick="deletePost(<%= index %>)">Delete</button>
        </li>
        <% }); %>
    </ul>
</div>
<script>
    function deletePost(index) {
        fetch('/delete/' + index, {method: 'DELETE'})
        .then(res => res.redirected ? window.location.href = '/' : null
        )
        .catch(err => console.error(err));
    }
    </script>
</body>
</html>